{
  "name": "honosvelte",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Full-stack boilerplate: Hono + bun:sqlite + Inertia v3 (Svelte 5) with auth, roles, SSR, Tailwind v4, migrations, tests and Docker.",
  "keywords": ["honosvelte", "hono", "bun", "inertia", "svelte", "tailwind", "sqlite", "boilerplate", "ssr"],
  "repository": {
    "type": "git",
    "url": "https://github.com/kabarpos/honosvelte.git"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": false,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:css": "bunx @tailwindcss/cli -i src/client/tailwind.css -o src/client/.tailwind.css --watch",
    "build": "bun run scripts/build.ts",
    "start": "NODE_ENV=production bun run src/index.ts",
    "db:seed": "bun run scripts/seed.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:server": "bun run scripts/e2e-server.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test --isolate tests/"
  },
  "dependencies": {
    "@inertiajs/svelte": "^3.6.1",
    "@sinclair/typebox": "^0.34.52",
    "hono": "^4.13.0",
    "nodemailer": "^9.0.5",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.2.0",
    "@types/nodemailer": "^8.0.1",
    "playwright": "^1.62.1",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0"
  }
}
