# Production deployment example — NO secrets, NO API keys.
# Copy to .env (or provide via the orchestrator) and fill in the real values.
# Anything unset falls back to the safe defaults in src/server/config.ts,
# and invalid/incomplete config fails fast at startup.

# --- Core ---
PORT=4000
NODE_ENV=production
# Absolute public base URL — used for email links and OAuth redirects.
# MUST be HTTPS in production.
APP_URL=https://your-domain.example
DATABASE_PATH=/app/data/app.sqlite
UPLOAD_DIR=/app/data/uploads
MEDIA_DIR=/app/data/media

# --- Mail (required for real sending; "log" prints instead of sending) ---
# MAIL_DRIVER=smtp | resend | mailtrap
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@your-domain.example
# SMTP host/user/pass are set in the admin UI (Settings → Email) and stored
# in the database — no env vars needed for them.
# Resend (when MAIL_DRIVER=resend): RESEND_API_KEY=
# Mailtrap (when MAIL_DRIVER=mailtrap): MAILTRAP_API_TOKEN=, MAILTRAP_INBOX_ID=

# --- Google OAuth (optional — both or none) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WhatsApp (optional; provider + key can be set in the admin UI) ---
DRIPSENDER_API_KEY=
DRIPSENDER_INTEGRATION_URL=
WHATSAPP_WEBHOOK_SECRET=

# --- Rate limiting ---
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_UPLOAD_WINDOW=60
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_WEBHOOK_WINDOW=60

# --- Reverse proxy (only if behind one you control) ---
# Comma-separated proxy networks (IP or IPv4 CIDR) trusted to set
# X-Forwarded-For. Leave empty otherwise — spoofed headers are ignored.
# TRUSTED_PROXY=10.0.0.0/8,192.168.1.10

# --- Uploads / bodies ---
TUS_MAX_SIZE=52428800
TUS_CHUNK_MAX=5242880
TUS_EXPIRATION_SECONDS=86400
REQUEST_BODY_LIMIT=100000
