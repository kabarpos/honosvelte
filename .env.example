# Server
PORT=4000
NODE_ENV=development
# Absolute base URL — used for email links and OAuth redirects
APP_URL=http://localhost:4000
DATABASE_PATH=./data/app.sqlite

# Mail — driver: log | resend | mailtrap
#   log      → prints to console (development default)
#   resend   → https://resend.com
#   mailtrap → https://mailtrap.io (set MAILTRAP_INBOX_ID to use the sandbox endpoint)
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
RESEND_API_KEY=
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# Google OAuth (optional — login button hidden when unset)
# Register: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp — provider: dripsender | log (set under Settings → WhatsApp)
#   dripsender → https://dripsender.id (set DRIPSENDER_API_KEY)
#   log        → records messages in sentWhatsapp (development default)
DRIPSENDER_API_KEY=
# Dripsender integration webhook (lead capture). New contacts (name + phone)
# captured on registration are POSTed here. Overridable under Settings → WhatsApp.
DRIPSENDER_INTEGRATION_URL=
# Required to accept inbound webhook events. Configure the same secret in Dripsender.
WHATSAPP_WEBHOOK_SECRET=

# Rate limiting for auth endpoints, upload writes, and WhatsApp webhook
# (requests per window, per IP). Auth is also account-aware.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_UPLOAD_WINDOW=60
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_WEBHOOK_WINDOW=60

# Reverse-proxy networks (IP or IPv4 CIDR, comma-separated) trusted to set
# X-Forwarded-For for rate limiting. LEAVE EMPTY unless the app runs behind
# a reverse proxy you control — otherwise clients can spoof the header and
# bypass per-IP limits. Example: TRUSTED_PROXY=10.0.0.0/8,192.168.1.10
TRUSTED_PROXY=

# Upload limits: 50 MiB maximum, 5 MiB per PATCH chunk, and 24-hour
# unfinished-upload expiry. 0 = unlimited (tests).
TUS_MAX_SIZE=52428800
TUS_CHUNK_MAX=5242880
TUS_EXPIRATION_SECONDS=86400
MEDIA_DIR=./data/media
UPLOAD_DIR=./data/uploads

# Bounded JSON request body for validated routes (bytes).
REQUEST_BODY_LIMIT=100000

# Retention (PERF-06): activity-log window in days (0 = keep forever).
ACTIVITY_RETENTION_DAYS=90
# In-app notification window in days (0 = keep forever; default off).
# Contact-message retention is intentionally not configurable — inbox data
# is business-critical and is never auto-deleted.
NOTIFICATION_RETENTION_DAYS=0

# Online backup destination (bun run backup). See docs/audit/backup-dr.md.
BACKUP_DIR=./data/backups
